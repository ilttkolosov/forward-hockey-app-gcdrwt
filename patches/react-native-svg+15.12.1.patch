+#if !TARGET_OS_OSX
+// A UIKit drawRect context can be a display list, not a bitmap. Even bitmap
+// "inspection" APIs log an invalid-context warning there. Filtered SVGs need
+// readable BackgroundImage pixels, so give the whole SVG an owned RGBA bitmap.
+static BOOL RNSVGContainsFilter(RNSVGPlatformView *view)
+{
+  if ([view isKindOfClass:[RNSVGFilter class]]) {
+    return YES;
+  }
+  for (RNSVGPlatformView *child in view.subviews) {
+    if (RNSVGContainsFilter(child)) {
+      return YES;
+    }
+  }
+  return NO;
+}
+#endif
 
