{
  "name": "Natively",
  "version": "2.4.51",
  "main": "index.ts",
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start --tunnel",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "build:web": "expo export -p web && npx workbox generateSW workbox-config.js",
    "build:android": "expo prebuild -p android",
    "lint": "eslint .",
    "postinstall": "patch-package && node scripts/seed-assets.mjs restore && node scripts/generate-player-photo-assets.mjs && node scripts/generate-team-logo-assets.mjs",
    "seed:generate": "node scripts/generate-seed-database.mjs && node scripts/seed-assets.mjs pack",
    "seed:migrate": "node scripts/seed-assets.mjs restore && node scripts/migrate-seed-database.mjs && node scripts/seed-assets.mjs pack",
    "seed:merge": "node scripts/merge-seed-database.mjs",
    "seed:restore": "node scripts/seed-assets.mjs restore",
    "seed:verify": "node scripts/seed-assets.mjs restore && node scripts/verify-seed-database.mjs",
    "photos:generate": "node scripts/generate-player-photo-assets.mjs",
    "photos:sync": "node scripts/sync-player-photo-assets.mjs && npm run photos:generate",
    "logos:generate": "node scripts/generate-team-logo-assets.mjs",
    "logos:sync": "node scripts/sync-team-logo-assets.mjs",
    "generate:route-types": "node scripts/generate-route-types.js",
    "version:patch": "node scripts/bump-app-version.mjs patch",
    "version:minor": "node scripts/bump-app-version.mjs minor",
    "check:messenger-unread": "node --no-warnings --experimental-strip-types checks/messenger-unread-policy.mjs",
    "check:messenger-player-identity": "node --no-warnings --experimental-strip-types checks/messenger-player-identity.mjs",
    "check:messenger-player-avatar": "node --no-warnings --experimental-strip-types checks/messenger-player-avatar.mjs",
    "check:messenger-message-mutation": "node --no-warnings --experimental-strip-types checks/messenger-message-mutation-policy.mjs",
    "check:messenger-android-keyboard": "node --no-warnings --experimental-strip-types checks/messenger-android-keyboard-avoidance.mjs",
    "check:startup-config": "node --no-warnings --experimental-strip-types checks/startup-config-policy.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run photos:generate && npm run logos:generate && npm run seed:verify && npm run generate:route-types && npm run check:messenger-unread && npm run check:messenger-player-identity && npm run check:messenger-player-avatar && npm run check:messenger-message-mutation && npm run check:messenger-avatar-ime-compat && npm run check:messenger-ios-registration && npm run check:messenger-android-keyboard && npm run check:startup-config && npm run typecheck && npm run lint",
    "prebuild": "expo prebuild",
    "eas-build": "npx --yes eas-cli@21.7.0 build",
    "check:messenger-avatar-ime-compat": "node --no-warnings --experimental-strip-types checks/messenger-avatar-ime-compat.mjs",
    "check:messenger-ios-registration": "node --no-warnings --experimental-strip-types checks/messenger-ios-registration.mjs"
  },
  "dependencies": {
    "@appmetrica/react-native-analytics": "^4.2.0",
    "@babel/runtime": "^7.26.9",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@magrinj/expo-quick-look": "0.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "buffer": "^6.0.3",
    "expo": "~54.0.31",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "5.1.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-compressor": "^2.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.12",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "metro-cache": "^0.83.1",
    "patch-package": "8.0.0",
    "sql.js": "^1.14.1",
    "typescript": "^5.8.3",
    "workbox-cli": "^7.4.0"
  },
  "private": true
}
